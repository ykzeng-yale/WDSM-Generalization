#!/bin/bash
# Prepare and freeze production_plan.csv before submission. This template does
# not select an account: pass an explicitly verified --account at submission.
# First submit --array=1-4%4 for representative timing. After review, submit
# --array=5-244%16 below. Never resubmit the completed timing IDs.
# Set WDSM_PACKAGE, WDSM_PRODUCTION_RUN, WDSM_RUN_MANIFEST and
# WDSM_SELECTED_ACCOUNT to verified absolute paths / the chosen account.
# Create the submission directory's logs/ before sbatch opens its output.
#SBATCH --job-name=wdsm-primary
#SBATCH --partition=day
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=2G
#SBATCH --time=00:30:00
#SBATCH --array=5-244%16
#SBATCH --output=logs/slurm-%A_%a.log
set -euo pipefail
: "${WDSM_PACKAGE:?Set the absolute frozen package-source path}"
: "${WDSM_PRODUCTION_RUN:?Set the absolute prepared production directory}"
: "${WDSM_RUN_MANIFEST:?Set the absolute immutable manifest path}"
: "${WDSM_SELECTED_ACCOUNT:?Set the explicitly selected authorized account}"
: "${SLURM_ARRAY_TASK_ID:?This template requires a Slurm array task}"
if [[ "${SLURM_JOB_ACCOUNT:-}" != "$WDSM_SELECTED_ACCOUNT" ]]; then
  printf '%s\n' 'Allocated account differs from the explicit selected account.' >&2
  exit 2
fi
module load R/4.4.2-gfbf-2024a
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
Rscript --vanilla "$WDSM_PACKAGE/simulations/production.R" run \
  "$WDSM_PACKAGE/simulations/production_config.csv" "$WDSM_PRODUCTION_RUN" \
  "$SLURM_ARRAY_TASK_ID" 1700
